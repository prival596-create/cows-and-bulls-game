[build]
command = "npm run build"
publish = "dist"

[[redirects]]
from = "/sw.js"
to = "/sw.js"
status = 200
force = true
headers = { "Content-Type" = "application/javascript" }

[[redirects]]
from = "/manifest.json"
to = "/manifest.json"
status = 200
force = true
headers = { "Content-Type" = "application/manifest+json" }
